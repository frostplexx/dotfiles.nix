function tm_exclude_node_modules --description "Exclude dependency dirs under DIR (default: cwd) from Time Machine"
    set -l EXCLUDED_DIRECTORIES env node_modules vendor venv
    set -l WORK_DIR (realpath (string length -q -- $argv[1]; and echo $argv[1]; or echo $PWD))

    for EXCLUDED_DIRECTORY in $EXCLUDED_DIRECTORIES
        fd -t d -H -I "^$EXCLUDED_DIRECTORY\$" $WORK_DIR -x tmutil addexclusion {}
    end
end
