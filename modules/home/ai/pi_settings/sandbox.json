{
  "enabled": true,
  "allowBrowserProcess": false,    
  "network": {
    "allowLocalBinding": true,    
    "allowAllUnixSockets": true,  
    "allowedDomains": ["github.com", "*.github.com"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [],
    "allowRead": ["/", "/nix"],

    "allowWrite": [".", "/tmp"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
