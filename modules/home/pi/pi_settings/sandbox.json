{
  "enabled": true,
  "enableAccessRequestTool": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 600,
  "allowBrowserProcess": false,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "disabled": true,
    "allowSSHAgentSocket": true,
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "flakehub.com",
      "*.flakehub.com",
      "cache.nixos.org",
      "channels.nixos.org",
      "*.cachix.org",
      "registry.npmjs.org",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "formulae.brew.sh",
      "ghcr.io",
      "kuipr.de",
      "*.kuipr.de"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [
      "/"
    ],
    "denyRead": [
      "/etc/ssh",
      "/etc/ssl",
      "/etc/pki",
      "/etc/ca-certificates",
      "/etc/ssl/certs",
      "/etc/ssl/private",
      "/etc/ssl/certs/ca-certificates.crt",
      "/usr/local/etc/openssl",
      "/usr/local/etc/openssl/cert.pem",
      "/usr/local/etc/openssl/certs",
      "/usr/local/etc/openssl/private",
      "/usr/local/etc/openssl/certs/ca-certificates.crt",
      "~/Music",
      "~/Pictures",
      "~/Videos",
      "~/.ssh"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/Documents/Memex/2 Resources/Homelab",
      "/Users/daniel/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "~/Library"
    ]
  }
}
