{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "schedule": [
    "at any time"
  ],
  "automerge": true,
  "automergeType": "pr",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    }
  ]
}
